    <div class="hero-overlay"></div>
    <img src="/prototipo-hilariom/galpao_pre_moldado.png" alt="Estrutura de Galpão Pré-fabricado Hilariom" class="hero-bg" style="object-fit: cover;" />
    <div class="hero-text">
      <div class="logo-hero-container fade-in-up">
        <img src="/prototipo-hilariom/logo.png?v=2" alt="Hilariom - Soluções em Métodos Construtivos" class="hero-logo" />
