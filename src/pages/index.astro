// Configuração do Vídeo Institucional Hilariom
// Cole abaixo o link completo do YouTube ou apenas o ID do vídeo (ex: 'https://www.youtube.com/watch?v=SEU_CODIGO' ou 'SEU_CODIGO')
const institucionalVideoUrlOuId = 'https://www.youtube.com/watch?v=ScMzIvxBSi4'; 

function getYoutubeEmbedUrl(input: string) {
  if (!input) return '';
  const match = input.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
  const id = match ? match[1] : input.trim();
  return `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
}
const institutionalVideoEmbedUrl = getYoutubeEmbedUrl(institucionalVideoUrlOuId);
