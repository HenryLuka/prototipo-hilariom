    <div class="scroll-container">
      <button class="scroll-btn left" aria-label="Rolar para esquerda"><svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
      <div class="markets-scroll horizontal-catalog scroll-area">
        {markets.map((m) => (
          <a href={m.href} class="market-card hover-scale">
            <div class="market-img skeleton">
              <img src={m.img} alt={m.title} loading="lazy" decoding="async" onload="this.parentElement.classList.remove('skeleton')" />
