      <a href="/prototipo-hilariom/contato/" class="hero-cta fade-in-up delay-1">
        <Icon name="icon_ce998bbf" class="cta-icon" width="22" height="22" />
        <span>Solicite um <strong>ORÇAMENTO</strong></span>
      </a>
    </div>
  </section>

  <div class="home-container">
  <!-- 2. ACESSO RÁPIDO -->
