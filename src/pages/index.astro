            alt="Vídeo Institucional Hilariom Estruturas Pré-Fabricadas" 
            class="video-poster-img"
            loading="lazy"
            decoding="async"
          />
          <div class="video-poster-gradient"></div>
          
          <button type="button" class="video-play-action" id="institutionalPlayBtn" aria-label="Reproduzir vídeo institucional da Hilariom">
