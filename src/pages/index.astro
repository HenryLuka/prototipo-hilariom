            </div>
            <span class="play-action-title">Assistir Apresentação Oficial</span>
            <span class="play-action-subtitle">Conheça nossa fábrica e capacidade construtiva</span>
          </button>
        </div>

        <!-- O Iframe oficial do YouTube com autoplay é acionado no play -->
        <div class="institutional-iframe-container" id="institutionalIframeContainer"></div>
      </div>
    </div>
  </section>

  <!-- 5. MERCADOS DE ATUAÇÃO -->
  <section class="markets-preview">
    <div class="section-header-premium fade-in-up">
      <div class="section-badge">MERCADOS</div>
