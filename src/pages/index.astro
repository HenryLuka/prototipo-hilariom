<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  // Gerenciador de carrosséis automáticos ultra-leve nativo (sem dependências)
  let carouselCleanups: Array<() => void> = [];

  function initCarousels() {
    // Limpa listeners e timers anteriores para navegação suave do Astro
    carouselCleanups.forEach(fn => fn());
    carouselCleanups = [];

    const containers = document.querySelectorAll('.scroll-container');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    containers.forEach(container => {
      const scrollArea = container.querySelector('.scroll-area') as HTMLElement | null;
      const leftBtn = container.querySelector('.scroll-btn.left') as HTMLElement | null;
      const rightBtn = container.querySelector('.scroll-btn.right') as HTMLElement | null;
      
      if (!scrollArea) return;
      const el = scrollArea as HTMLElement;

      const getCardWidth = () => {
        const firstCard = el.children[0] as HTMLElement | null;
        if (!firstCard) return 300;
        const style = getComputedStyle(el);
        const gap = parseFloat(style.gap) || 16;
        return firstCard.offsetWidth + gap;
      };

      const updateButtons = () => {
        const { scrollLeft, scrollWidth, clientWidth } = el;
        if (leftBtn) {
          if (scrollLeft > 5) {
            leftBtn.classList.add('visible');
            container.classList.add('can-scroll-left');
          } else {
            leftBtn.classList.remove('visible');
            container.classList.remove('can-scroll-left');
          }
        }
        
        if (rightBtn) {
          if (scrollLeft + clientWidth < scrollWidth - 15) {
            rightBtn.classList.add('visible');
            container.classList.add('can-scroll-right');
          } else {
            rightBtn.classList.remove('visible');
            container.classList.remove('can-scroll-right');
          }
        }
      };

      el.addEventListener('scroll', updateButtons, { passive: true });
      window.addEventListener('resize', updateButtons, { passive: true });
      setTimeout(updateButtons, 100);

      // Controle de rotação automática
      let autoTimer: any = null;
      let isHovered = false;
      let isTouching = false;
      let isVisible = false;

      function advanceNext() {
        const { scrollLeft, scrollWidth, clientWidth } = el;
        // Se chegou ao fim do carrossel, volta suavemente ao início
        if (scrollLeft + clientWidth >= scrollWidth - 20) {
          el.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          el.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
        }
      }

      function startAutoScroll() {
        stopAutoScroll();
        if (prefersReducedMotion) return;
        autoTimer = setInterval(() => {
          if (!isHovered && !isTouching && isVisible && document.visibilityState === 'visible') {
            advanceNext();
          }
        }, 3600);
      }

      function stopAutoScroll() {
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }

      function resetAutoScroll() {
        startAutoScroll();
      }

      if (leftBtn) {
        leftBtn.addEventListener('click', () => {
          el.scrollBy({ left: -(getCardWidth()), behavior: 'smooth' });
          resetAutoScroll();
        });
      }

      if (rightBtn) {
        rightBtn.addEventListener('click', () => {
          advanceNext();
          resetAutoScroll();
        });
      }

      // Pausa ao passar o mouse (desktop) para permitir leitura sem pressa
      const onMouseEnter = () => { isHovered = true; };
      const onMouseLeave = () => { isHovered = false; };
      container.addEventListener('mouseenter', onMouseEnter, { passive: true });
      container.addEventListener('mouseleave', onMouseLeave, { passive: true });

      // Pausa ao tocar/arrastar (mobile) para não interferir no gesto do usuário
      const onTouchStart = () => { isTouching = true; };
      const onTouchEnd = () => { setTimeout(() => { isTouching = false; }, 2200); };
      container.addEventListener('touchstart', onTouchStart, { passive: true });
      container.addEventListener('touchend', onTouchEnd, { passive: true });

      // IntersectionObserver: só consome timer quando estiver visível no viewport (0% CPU fora da tela)
      let observer: IntersectionObserver | null = null;
      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            isVisible = entry.isIntersecting;
            if (isVisible) {
              startAutoScroll();
            } else {
              stopAutoScroll();
            }
          });
        }, { threshold: 0.2 });

        observer.observe(container);
      } else {
        isVisible = true;
        startAutoScroll();
      }

      // Função de limpeza para evitar vazamento de memória ou timers duplicados
      carouselCleanups.push(() => {
        stopAutoScroll();
        if (observer) observer.disconnect();
        container.removeEventListener('mouseenter', onMouseEnter);
        container.removeEventListener('mouseleave', onMouseLeave);
        container.removeEventListener('touchstart', onTouchStart);
        container.removeEventListener('touchend', onTouchEnd);
      });
    });
  }

  function initVideoPlayer() {
    const facade = document.getElementById('institutionalVideoFacade');
    const playerBox = document.getElementById('institutionalPlayerBox');
    const iframeSlot = document.getElementById('institutionalIframeContainer');

    if (!facade || !playerBox || !iframeSlot) return;

    facade.addEventListener('click', () => {
      const src = playerBox.getAttribute('data-video-src');
      if (!src) return;
      iframeSlot.innerHTML = `<iframe src="${src}" title="Vídeo Institucional Hilariom" style="width:100%;height:100%;border:0;position:absolute;top:0;left:0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
      facade.style.display = 'none';
    });
  }

  const FACTORY_LAT = -23.3191164;
  const FACTORY_LNG = -46.1231937;
  let homeMapInstance: L.Map | null = null;

  function initHomeCoverageMap() {
    const mapEl = document.getElementById('home-coverage-map');
    if (!mapEl) return;

    if (homeMapInstance) {
      try {
        homeMapInstance.remove();
      } catch (e) {}
      homeMapInstance = null;
    }

    const map = L.map(mapEl, {
      center: [FACTORY_LAT, FACTORY_LNG],
      zoom: 6,
      scrollWheelZoom: false,
      zoomControl: false,
      attributionControl: false
    });
    homeMapInstance = map;

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      subdomains: ['a', 'b', 'c'],
      maxZoom: 19
    }).addTo(map);

    // Raio Geodésico de 500 km
    const circle500 = L.circle([FACTORY_LAT, FACTORY_LNG], {
      radius: 500000,
      color: '#343432',
      weight: 2,
      dashArray: '6, 6',
      fillColor: '#fce883',
      fillOpacity: 0.22
    }).addTo(map);

    // Raio Intermediário 250 km
    L.circle([FACTORY_LAT, FACTORY_LNG], {
      radius: 250000,
      color: '#4a4a47',
      weight: 1.5,
      dashArray: '4, 4',
      fillColor: '#fce883',
      fillOpacity: 0.12
    }).addTo(map);

    // Raio Imediato 100 km
    L.circle([FACTORY_LAT, FACTORY_LNG], {
      radius: 100000,
      color: '#262624',
      weight: 2,
      fillColor: '#fce883',
      fillOpacity: 0.28
    }).addTo(map);

    // Pino na Fábrica
    const markerIcon = L.divIcon({
      className: 'home-factory-pin',
      html: `
        <div class="home-pin-wrap">
          <span class="home-pin-pulse"></span>
          <div class="home-pin-icon">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
          </div>
        </div>
      `,
      iconSize: [32, 32],
      iconAnchor: [16, 16]
    });

    L.marker([FACTORY_LAT, FACTORY_LNG], { icon: markerIcon }).addTo(map);

    map.fitBounds(circle500.getBounds(), { padding: [10, 10] });

    setTimeout(() => {
      map.invalidateSize();
    }, 250);
  }

  document.addEventListener('astro:page-load', () => {
    initCarousels();
    initVideoPlayer();
    initHomeCoverageMap();
  });
  // Fallback para primeiro carregamento
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initCarousels();
      initVideoPlayer();
      initHomeCoverageMap();
    });
  } else {
    initCarousels();
    initVideoPlayer();
    initHomeCoverageMap();
  }
</script>
