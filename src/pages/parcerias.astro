---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { asset } from '../utils/asset';

// Clientes - editados no painel em "Clientes". Menor "ordem" aparece primeiro.
const clientes = Object.values(import.meta.glob('../data/clientes/*.json', { eager: true }))
  .map((f: any) => f.default || f)
  .sort((a: any, b: any) => (a.ordem ?? 99) - (b.ordem ?? 99));

// Titulo de cada obra, por id. So vira link a obra que ainda existe: se uma
// obra for apagada no painel, o cartao perde o link em vez de levar a um 404.
const obras = new Map<string, string>(
  Object.values(import.meta.glob('../data/obras/*.json', { eager: true }))
    .map((f: any) => f.default || f)
    .map((o: any) => [o.id, o.title])
);

// Sem logo, o cartao mostra as iniciais do nome no lugar da imagem.
const PALAVRAS_MENORES = new Set(['de', 'do', 'da', 'dos', 'das', 'e']);
function iniciais(nome: string) {
  return nome.split(/\s+/)
    .filter((p) => p && !PALAVRAS_MENORES.has(p.toLowerCase()))
    .slice(0, 2)
    .map((p) => p[0].toUpperCase())
    .join('');
}
---

<Layout title="Nossos Clientes">
  <PageHeader
    title1="Nossos"
    title2="Clientes"
    subtitle="Indústrias, operadores logísticos e empresas que confiaram suas obras às estruturas pré-fabricadas Hilariom."
  />

  <section class="partners-grid fade-in-up delay-1">
    {clientes.map((c: any) => {
      const obraTitulo = c.obra ? obras.get(c.obra) : undefined;
      return (
        <article class="partner-card-premium">
          <div class="partner-logo-wrapper">
            {c.logo
              ? <img src={asset(c.logo)} alt={`Logo ${c.nome}`} loading="lazy" decoding="async" />
              : <span class="client-monogram" aria-hidden="true">{iniciais(c.nome)}</span>}
          </div>
          <div class="partner-info-premium">
            <h2 class="client-name">{c.nome}</h2>
            <span class="partner-badge">{c.segmento}{c.cidade && ` · ${c.cidade}`}</span>
            {c.sobre && <p class="client-about">{c.sobre}</p>}
            {obraTitulo && (
              <a href={asset(`/obras/${c.obra}/`)} class="client-obra-link">
                Ver obra: {obraTitulo} <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </article>
      );
    })}
  </section>

  <section class="cta-section fade-in-up delay-2">
    <div class="cta-box glass-panel">
      <h3>Quer ser um fornecedor?</h3>
      <p>Junte-se à nossa rede de fornecedores e faça parte de grandes obras pelo país.</p>
      <a href="/prototipo-hilariom/seja-parceiro/" class="btn-primary hover-scale">Cadastre sua Empresa</a>
    </div>
  </section>
</Layout>

<style>
  /* ===== GRID DE CLIENTES ===== */
  .partners-grid {
    padding: 0 1.5rem 3rem;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .partners-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .partners-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .partner-card-premium {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid rgba(0,0,0,0.04);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .partner-card-premium:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.06);
    border-color: rgba(252, 232, 131, 0.5);
  }

  .partner-logo-wrapper {
    background: #fafafa;
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgba(0,0,0,0.03);
    aspect-ratio: 16/9;
  }

  .partner-logo-wrapper img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: filter 0.4s ease, opacity 0.4s ease, transform 0.4s ease;
  }

  .partner-card-premium:hover .partner-logo-wrapper img {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.05);
  }

  .client-monogram {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(252, 232, 131, 0.35);
    color: var(--text-main);
    font-size: 1.6rem;
    font-weight: 900;
    letter-spacing: 0.03em;
  }

  .partner-info-premium {
    padding: 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .client-name {
    font-size: 1.1rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-main);
    margin: 0;
  }

  .partner-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(252, 232, 131, 0.15);
    color: #a89115;
    padding: 0.4rem 0.85rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .client-about {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
    max-width: 38ch;
  }

  .client-obra-link {
    margin-top: auto;
    padding-top: 0.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-main);
    text-decoration: none;
    border-bottom: 2px solid var(--accent-color);
  }

  .client-obra-link:hover,
  .client-obra-link:focus-visible {
    border-bottom-color: var(--text-main);
    outline: none;
  }

  /* ===== CTA SECTION ===== */
  .cta-section {
    padding: 0 1.5rem 5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .cta-box {
    background: var(--surface-color);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    text-align: center;
    border-top: 4px solid #fce883;
  }

  .cta-box h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .cta-box p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
    color: #ffffff;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    width: 100%;
  }

  @media (min-width: 768px) {
    .btn-primary {
      width: auto;
    }
  }
</style>
