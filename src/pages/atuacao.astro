---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const factoryAddress = "R. Ceará, 212 - Parateí, Guararema - SP, 08900-000";
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(factoryAddress)}`;
const wazeUrl = `https://waze.com/ul?q=${encodeURIComponent(factoryAddress)}`;
const whatsappUrl = `https://api.whatsapp.com/send?phone=5511989652498&text=${encodeURIComponent("Olá! Gostaria de consultar a viabilidade e orçamento para minha obra partindo da fábrica de Guararema (raio de 500km).")}`;
---

<Layout title="Raio de Atuação | Hilariom">
  <PageHeader 
    title1="Raio de" 
    title2="Atuação" 
    subtitle="Logística inteligente e montagem rápida partindo de nossa fábrica em Guararema - SP."
  />

  <section class="map-section fade-in-up delay-2">
    <!-- Card do Ponto de Partida -->
    <div class="origin-card glass-panel">
      <div class="origin-badge">PONTO DE PARTIDA</div>
      <div class="origin-header">
        <div class="origin-icon">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div class="origin-text">
          <h2>Fábrica & Centro Operacional Hilariom</h2>
          <p class="origin-address">{factoryAddress}</p>
        </div>
      </div>
      <div class="origin-actions">
        <a href={mapsUrl} target="_blank" rel="noopener" class="origin-btn google-btn hover-scale">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          <span>Abrir no Google Maps</span>
        </a>
        <a href={wazeUrl} target="_blank" rel="noopener" class="origin-btn waze-btn hover-scale">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8l4 4-4 4"/></svg>
          <span>Navegar no Waze</span>
        </a>
      </div>
    </div>

    <!-- Mapa Real Geográfico Interativo com Leaflet -->
    <div class="real-map-card glass-panel">
      <div class="map-toolbar">
        <div class="map-live-tag">
          <span class="live-dot"></span>
          <span>Mapa Geográfico Real &bull; Escala Geodésica</span>
        </div>
        <div class="map-actions">
          <button type="button" id="btn-fit-500" class="map-btn active" title="Enquadrar o raio de 500 km">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            <span>Raio 500 km</span>
          </button>
          <button type="button" id="btn-focus-factory" class="map-btn" title="Aproximar na fábrica em Guararema">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            <span>Ver Fábrica</span>
          </button>
        </div>
      </div>

      <div class="map-viewport">
        <div id="coverage-map" class="map-canvas"></div>
      </div>

      <div class="map-legend-bar">
        <div class="legend-chip">
          <span class="chip-circle c-500"></span>
          <span><strong>500 km:</strong> Alcance Máximo (SP, RJ, Sul de MG, PR)</span>
        </div>
        <div class="legend-chip">
          <span class="chip-circle c-250"></span>
          <span><strong>250 km:</strong> Raio Estratégico</span>
        </div>
        <div class="legend-chip">
          <span class="chip-circle c-100"></span>
          <span><strong>100 km:</strong> Raio Imediato (SP, Vale & Campinas)</span>
        </div>
      </div>
    </div>

    <!-- Diferenciais Logísticos -->
    <div class="logistics-grid">
      <div class="logistics-item glass-panel">
        <div class="log-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        </div>
        <div class="log-info">
          <h4>Acesso Rodoviário Estratégico</h4>
          <p>Conexão rápida à Rodovia Presidente Dutra (BR-116), Ayrton Senna / Carvalho Pinto (SP-070) e Rodoanel Mário Covas.</p>
        </div>
      </div>

      <div class="logistics-item glass-panel">
        <div class="log-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="log-info">
          <h4>Agilidade & Pontualidade</h4>
          <p>Frota própria e transportadores homologados para peças de grande porte e vãos especiais.</p>
        </div>
      </div>
    </div>
    
    <!-- Regiões Atendidas -->
    <div class="info-card">
      <div class="section-badge">COBERTURA REGIONAL</div>
      <h3>Estados em que Atuamos</h3>
      <p class="text-muted">Nossa malha logística atende grandes empreendimentos em até 500km de distância terrestre a partir de Guararema:</p>
      
      <div class="states-cards-grid">
        <div class="state-card">
          <div class="state-header">
            <span class="state-badge">SP</span>
            <strong>São Paulo</strong>
          </div>
          <p>Grande São Paulo, Vale do Paraíba, Alto Tietê, Campinas, Sorocaba, Baixada Santista e todo interior.</p>
        </div>

        <div class="state-card">
          <div class="state-header">
            <span class="state-badge">RJ</span>
            <strong>Rio de Janeiro</strong>
          </div>
          <p>Região Metropolitana, Sul Fluminense (Resende, Volta Redonda, Barra Mansa) e Costa Verde.</p>
        </div>

        <div class="state-card">
          <div class="state-header">
            <span class="state-badge">MG</span>
            <strong>Minas Gerais</strong>
          </div>
          <p>Sul de Minas (Pouso Alegre, Varginha, Extrema, Itajubá), Zona da Mata e Campo das Vertentes.</p>
        </div>

        <div class="state-card">
          <div class="state-header">
            <span class="state-badge">PR</span>
            <strong>Paraná</strong>
          </div>
          <p>Região Metropolitana de Curitiba, Litoral Paranaense e Norte Pioneiro do estado.</p>
        </div>
      </div>
    </div>

    <!-- CTA de Consulta -->
    <div class="viabilidade-cta glass-panel">
      <div class="cta-text">
        <h3>Sua obra está nessa região?</h3>
        <p>Consulte nossa equipe para verificar prazos de entrega e simular o plano de montagem para a sua cidade.</p>
      </div>
      <a href={whatsappUrl} target="_blank" rel="noopener" class="cta-whatsapp-btn hover-scale">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span>Consultar Frete & Montagem</span>
      </a>
    </div>
  </section>

</Layout>

<style>
  .text-muted { color: var(--text-muted); }

  .map-section {
    padding: 1rem 1.5rem 4rem;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Card do Ponto de Partida */
  .origin-card {
    background: #ffffff;
    border-radius: var(--border-radius);
    padding: 1.5rem;
    border-left: 5px solid #fce883;
    box-shadow: var(--shadow-sm);
  }

  .origin-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #a89115;
    background: rgba(252, 232, 131, 0.3);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }

  .origin-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .origin-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #343432;
    color: #fce883;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .origin-text h2 {
    font-size: 1.15rem;
    color: var(--text-main);
    margin-bottom: 0.25rem;
    font-weight: 800;
  }

  .origin-address {
    font-size: 0.92rem;
    color: var(--text-muted);
    font-weight: 500;
    margin: 0;
  }

  .origin-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .origin-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .google-btn {
    background: #343432;
    color: #ffffff;
  }

  .google-btn svg {
    color: #fce883;
  }

  .waze-btn {
    background: #f4f4f2;
    color: #343432;
    border: 1px solid rgba(0,0,0,0.08);
  }

  /* Real Map Styling */
  .real-map-card {
    background: #ffffff;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.08);
  }

  .map-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    background: #ffffff;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .map-live-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #343432;
    letter-spacing: 0.2px;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
    animation: dot-pulse 2s infinite;
  }

  @keyframes dot-pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
    100% { transform: scale(1); opacity: 1; }
  }

  .map-actions {
    display: flex;
    gap: 0.5rem;
  }

  .map-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 700;
    border: 1px solid rgba(0,0,0,0.12);
    background: #f8f8f6;
    color: #343432;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .map-btn:hover {
    background: #e8e8e4;
  }

  .map-btn.active {
    background: #343432;
    color: #fce883;
    border-color: #343432;
  }

  .map-viewport {
    height: 460px;
    width: 100%;
    position: relative;
    background: #f4f4f2;
  }

  .map-canvas {
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .map-legend-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 0.9rem 1.25rem;
    background: #fafaf8;
    border-top: 1px solid rgba(0,0,0,0.06);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .legend-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .chip-circle {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .c-500 {
    background: #fce883;
    border: 2px dashed #343432;
  }

  .c-250 {
    background: rgba(252, 232, 131, 0.5);
    border: 1.5px dashed #555;
  }

  .c-100 {
    background: #fce883;
    border: 2px solid #262624;
  }

  /* Injected Leaflet elements need :global */
  :global(.factory-div-icon) {
    background: transparent !important;
    border: none !important;
  }

  :global(.factory-marker-wrapper) {
    position: relative;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.factory-marker-pulse) {
    position: absolute;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(252, 232, 131, 0.65);
    animation: marker-pulse-anim 2s infinite;
    z-index: 1;
  }

  :global(.factory-marker-pin) {
    position: relative;
    z-index: 2;
    width: 32px;
    height: 32px;
    background: #343432;
    color: #fce883;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
    border: 2px solid #ffffff;
  }

  @keyframes marker-pulse-anim {
    0% { transform: scale(0.8); opacity: 0.9; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  :global(.leaflet-hilariom-popup) {
    padding: 0.2rem;
    min-width: 190px;
    font-family: inherit;
  }

  :global(.leaflet-hilariom-popup .popup-badge) {
    display: inline-block;
    background: #343432;
    color: #fce883;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.35rem;
    letter-spacing: 0.5px;
  }

  :global(.leaflet-hilariom-popup .popup-title) {
    display: block;
    font-size: 0.95rem;
    color: #111;
    margin-bottom: 0.2rem;
    font-weight: 800;
  }

  :global(.leaflet-hilariom-popup .popup-addr) {
    font-size: 0.8rem;
    color: #555;
    margin: 0 0 0.5rem 0;
    line-height: 1.35;
  }

  :global(.leaflet-hilariom-popup .popup-meta) {
    font-size: 0.72rem;
    font-weight: 700;
    color: #166534;
    background: #dcfce7;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.6rem;
  }

  :global(.leaflet-hilariom-popup .popup-link) {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    color: #343432;
    text-decoration: underline;
  }

  /* Logistics Grid */
  .logistics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .logistics-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .logistics-item {
    background: #ffffff;
    padding: 1.25rem;
    border-radius: var(--border-radius);
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    box-shadow: var(--shadow-sm);
  }

  .log-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(252, 232, 131, 0.2);
    color: #343432;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .log-info h4 {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .log-info p {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin: 0;
  }

  /* Estados Atendidos */
  .info-card {
    background: #ffffff;
    padding: 1.5rem;
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md);
  }

  .info-card h3 {
    margin-bottom: 0.35rem;
    color: var(--text-main);
    font-size: 1.25rem;
    font-weight: 800;
  }
  
  .info-card p.text-muted {
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .states-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .states-cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .state-card {
    background: #f8f8f6;
    border-radius: 10px;
    padding: 1rem;
    border: 1px solid rgba(0,0,0,0.05);
  }

  .state-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .state-badge {
    background: #343432;
    color: #fce883;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .state-header strong {
    color: var(--text-main);
    font-size: 0.95rem;
  }

  .state-card p {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }

  /* Viabilidade CTA */
  .viabilidade-cta {
    background: linear-gradient(135deg, #343432 0%, #1e1e1c 100%);
    border-radius: var(--border-radius);
    padding: 1.5rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    box-shadow: 0 10px 25px rgba(52, 52, 50, 0.2);
  }

  @media (min-width: 640px) {
    .viabilidade-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 2rem;
    }
  }

  .cta-text h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
    color: #ffffff;
  }

  .cta-text p {
    font-size: 0.88rem;
    color: #c9c9c4;
    margin: 0;
    line-height: 1.45;
  }

  .cta-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #25D366;
    color: #ffffff;
    padding: 0.85rem 1.4rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.35);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const FACTORY_LAT = -23.3191164;
  const FACTORY_LNG = -46.1231937;

  let currentMap: L.Map | null = null;

  function initCoverageMap() {
    const mapContainer = document.getElementById('coverage-map');
    if (!mapContainer) return;

    // Clean up existing map instance if any (for Astro view-transitions)
    if (currentMap) {
      try {
        currentMap.remove();
      } catch (e) {
        // ignore
      }
      currentMap = null;
    }

    // Initialize Leaflet Map
    const map = L.map(mapContainer, {
      center: [FACTORY_LAT, FACTORY_LNG],
      zoom: 7,
      scrollWheelZoom: false,
      attributionControl: true
    });
    currentMap = map;

    // CartoDB Voyager tiles (crisp, modern styling with roads, state lines and cities)
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);

    // 500 km Geodesic circle (500,000 meters radius)
    const circle500 = L.circle([FACTORY_LAT, FACTORY_LNG], {
      radius: 500000,
      color: '#343432',
      weight: 2,
      dashArray: '8, 8',
      fillColor: '#fce883',
      fillOpacity: 0.18
    }).addTo(map);

    // 250 km Geodesic circle
    L.circle([FACTORY_LAT, FACTORY_LNG], {
      radius: 250000,
      color: '#4a4a47',
      weight: 1.5,
      dashArray: '5, 5',
      fillColor: '#fce883',
      fillOpacity: 0.12
    }).addTo(map);

    // 100 km Geodesic circle
    L.circle([FACTORY_LAT, FACTORY_LNG], {
      radius: 100000,
      color: '#262624',
      weight: 2,
      fillColor: '#fce883',
      fillOpacity: 0.28
    }).addTo(map);

    // Custom Marker for Factory
    const factoryIcon = L.divIcon({
      className: 'factory-div-icon',
      html: `
        <div class="factory-marker-wrapper">
          <span class="factory-marker-pulse"></span>
          <div class="factory-marker-pin">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
          </div>
        </div>
      `,
      iconSize: [36, 36],
      iconAnchor: [18, 18],
      popupAnchor: [0, -20]
    });

    const marker = L.marker([FACTORY_LAT, FACTORY_LNG], { icon: factoryIcon }).addTo(map);

    const popupContent = `
      <div class="leaflet-hilariom-popup">
        <span class="popup-badge">FÁBRICA HILARIOM</span>
        <strong class="popup-title">Origem do Frete</strong>
        <p class="popup-addr">R. Ceará, 212 - Parateí<br>Guararema - SP, 08900-000</p>
        <div class="popup-meta">
          <span>Alcance: Raio até 500 km</span>
        </div>
        <a href="https://maps.google.com/?q=R.+Cear%C3%A1,+212+-+Parate%C3%AD,+Guararema+-+SP,+08900-000" target="_blank" rel="noopener" class="popup-link">
          Abrir rota no Google Maps &rarr;
        </a>
      </div>
    `;

    marker.bindPopup(popupContent);

    // Fit map bounds to show the entire 500 km radius
    map.fitBounds(circle500.getBounds(), { padding: [25, 25] });

    // Buttons actions
    const btn500 = document.getElementById('btn-fit-500');
    const btnFactory = document.getElementById('btn-focus-factory');

    btn500?.addEventListener('click', () => {
      btn500.classList.add('active');
      btnFactory?.classList.remove('active');
      map.fitBounds(circle500.getBounds(), { padding: [25, 25], animate: true });
    });

    btnFactory?.addEventListener('click', () => {
      btnFactory.classList.add('active');
      btn500?.classList.remove('active');
      map.setView([FACTORY_LAT, FACTORY_LNG], 15, { animate: true });
      marker.openPopup();
    });

    // Invalidate map size after animation/render
    setTimeout(() => {
      map.invalidateSize();
    }, 250);
  }

  // Support both standard DOMContentLoaded and Astro view-transitions
  document.addEventListener('astro:page-load', initCoverageMap);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initCoverageMap();
  }
</script>
