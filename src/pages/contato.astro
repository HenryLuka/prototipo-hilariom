---import Icon from '../components/Icon.astro';

import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="Contato e Orçamento" hideCta={true}>
  <PageHeader 
    title1="Fale" 
    title2="Conosco" 
    subtitle="Vamos construir juntos. Entre em contato para orçamentos e mais informações."
  />

  <section class="contact-section fade-in-up delay-2">
    <!-- WhatsApp Direct Button -->
    <a href="https://api.whatsapp.com/send?phone=5511989652498&text=Ol%C3%A1!%20Vim%20pelo%20site%20e%20gostaria%20de%20fazer%20um%20or%C3%A7amento" class="whatsapp-btn hover-scale" target="_blank" rel="noopener">
      <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg></span>
      <div class="btn-text">
        <strong>Fale via WhatsApp</strong>
        <span>Resposta rápida</span>
      </div>
      <span class="arrow">&rarr;</span>
    </a>

    <div class="divider">ou envie uma mensagem</div>

    <!-- Contact Form -->
    <form class="contact-form glass-panel">
      <div class="form-group">
        <label for="name">Nome completo</label>
        <input type="text" id="name" placeholder="Ex: João da Silva" required />
      </div>
      
      <div class="form-group">
        <label for="email">E-mail</label>
        <input type="email" id="email" placeholder="joao@empresa.com" required />
      </div>
      
      <div class="form-group">
        <label for="phone">Telefone</label>
        <input type="tel" id="phone" placeholder="(11) 99999-9999" required />
      </div>

      <div class="form-group">
        <label for="message">Mensagem ou Detalhes da Obra</label>
        <textarea id="message" rows="4" placeholder="Descreva sua necessidade..."></textarea>
      </div>

      <button type="button" class="submit-btn hover-scale" onclick="alert('Formulário enviado com sucesso! (Simulação)')">Solicitar Orçamento</button>
    </form>
    
    <!-- Factory Address Card -->
    <div class="factory-contact-card">
      <div class="factory-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
      </div>
      <div class="factory-details">
        <span class="factory-badge">FÁBRICA & CENTRO LOGÍSTICO</span>
        <strong>Hilariom Pré-Fabricados</strong>
        <p>R. Ceará, 212 - Parateí, Guararema - SP, 08900-000</p>
        <div class="factory-actions">
          <a href="https://maps.google.com/?q=R.+Cear%C3%A1,+212+-+Parate%C3%AD,+Guararema+-+SP,+08900-000" target="_blank" rel="noopener" class="factory-link-btn">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            Ver no Google Maps
          </a>
        </div>
      </div>
    </div>

    <!-- Social links -->
    <div class="social-links">
      <a href="https://www.linkedin.com/company/hilariom-pr%C3%A9-fabricados/" target="_blank" rel="noopener" class="social-icon hover-scale" aria-label="LinkedIn">
        <Icon name="icon_1a61bb9b" width="22" height="22" />
      </a>
      <a href="https://www.facebook.com/hilariomprefabricados" target="_blank" rel="noopener" class="social-icon hover-scale" aria-label="Facebook">
        <Icon name="icon_f7ce034e" width="22" height="22" />
      </a>
      <a href="https://www.instagram.com/hilariom.prefab" target="_blank" rel="noopener" class="social-icon hover-scale" aria-label="Instagram">
        <Icon name="icon_5e01f710" width="22" height="22" />
      </a>
    </div>
  </section>
</Layout>

<style>
  .text-muted { color: var(--text-muted); }

  .contact-section {
    padding: 1.5rem 1.5rem 3rem;
  }

  .whatsapp-btn {
    display: flex;
    align-items: center;
    background: #25D366;
    color: white;
    padding: 1rem 1.25rem;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
    margin-bottom: 1.5rem;
  }

  .whatsapp-btn .icon {
    font-size: 1.8rem;
    margin-right: 1rem;
  }

  .whatsapp-btn .btn-text {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .whatsapp-btn .btn-text strong {
    font-size: 1.1rem;
  }

  .whatsapp-btn .btn-text span {
    font-size: 0.8rem;
    opacity: 0.9;
  }

  .whatsapp-btn .arrow {
    font-size: 1.2rem;
    font-weight: bold;
  }

  .divider {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 1.5rem 0;
    position: relative;
  }

  .divider::before, .divider::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 25%;
    height: 1px;
    background: var(--border-color);
  }

  .divider::before { left: 0; }
  .divider::after { right: 0; }

  .contact-form {
    padding: 1.5rem;
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    margin-bottom: 2rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .form-group input, .form-group textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 2px solid #a0a0a0;
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    background: #ffffff;
    color: var(--text-main);
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-group input::placeholder, .form-group textarea::placeholder {
    color: #888888;
  }

  .form-group input:focus, .form-group textarea:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(52, 52, 50, 0.1);
  }

  .submit-btn {
    width: 100%;
    padding: 1rem;
    background: var(--accent-color);
    color: var(--primary-color);
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface-color);
    color: var(--primary-color);
    font-weight: bold;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-color);
  }

  .factory-contact-card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--border-radius);
    padding: 1.25rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .factory-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(252, 232, 131, 0.25);
    color: #343432;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .factory-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .factory-badge {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #6b6b66;
  }

  .factory-details strong {
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .factory-details p {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin: 0 0 0.5rem 0;
    line-height: 1.4;
  }

  .factory-actions {
    display: flex;
    gap: 0.5rem;
  }

  .factory-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #343432;
    background: #f4f4f2;
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .factory-link-btn:hover {
    background: #343432;
    color: #fce883;
  }
</style>



